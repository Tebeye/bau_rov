<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tema1_hat_takibi_world">
    <!-- Directional Light mimicking underwater sunlight -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Underwater ambient atmosphere parameters -->
    <scene>
      <ambient>0.1 0.3 0.4 1.0</ambient>
      <background>0.05 0.15 0.25 1.0</background>
      <shadows>true</shadows>
      <fog>
        <color>0.05 0.2 0.3 1.0</color>
        <type>linear</type>
        <start>1.0</start>
        <end>15.0</end>
        <density>0.1</density>
      </fog>
    </scene>

    <!-- Pool / Ocean Floor Ground Plane -->
    <model name="pool_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.4 0.5 1</ambient>
            <diffuse>0.2 0.4 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yellow Line Path for Underwater Tracking (tema1_hat_takibi) -->
    <model name="underwater_yellow_line_path">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose> <!-- Slightly elevated off pool floor -->
      <!-- Segment 1: Main Straight Line -->
      <link name="segment_1">
        <visual name="visual_seg1">
          <pose>2.5 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>5.0 0.15 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.84 0.0 1</ambient>
            <diffuse>1.0 0.84 0.0 1</diffuse>
            <emissive>0.2 0.2 0.0 1</emissive>
          </material>
        </visual>
      </link>
      <!-- Segment 2: Curved Path / Corner -->
      <link name="segment_2">
        <visual name="visual_seg2">
          <pose>5.0 1.5 0 0 0 1.5708</pose>
          <geometry>
            <box>
              <size>3.0 0.15 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.84 0.0 1</ambient>
            <diffuse>1.0 0.84 0.0 1</diffuse>
            <emissive>0.2 0.2 0.0 1</emissive>
          </material>
        </visual>
      </link>
      <!-- Segment 3: Return Path -->
      <link name="segment_3">
        <visual name="visual_seg3">
          <pose>2.5 3.0 0 0 0 3.14159</pose>
          <geometry>
            <box>
              <size>5.0 0.15 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.84 0.0 1</ambient>
            <diffuse>1.0 0.84 0.0 1</diffuse>
            <emissive>0.2 0.2 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Physics Parameters -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

  </world>
</sdf>
