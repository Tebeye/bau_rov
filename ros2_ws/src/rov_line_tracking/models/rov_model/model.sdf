<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="rov_model">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>

    <!-- Main Chassis Link -->
    <link name="base_link">
      <inertial>
        <mass>10.0</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.2</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.3</iyy>
          <iyz>0.0</iyz>
          <izz>0.3</izz>
        </inertia>
      </inertial>

      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.5 0.35 0.25</size>
          </box>
        </geometry>
      </collision>

      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.5 0.35 0.25</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.5 0.8 1</diffuse>
        </material>
      </visual>

      <!-- Downward Facing Camera Sensor Link & Joint -->
      <sensor name="downward_camera" type="camera">
        <pose>0.15 0 -0.1 0 1.5708 0</pose> <!-- Oriented straight down (-Z axis) -->
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace></namespace>
            <remapping>image_raw:=/camera/image_raw</remapping>
            <remapping>camera_info:=/camera/camera_info</remapping>
          </ros>
          <camera_name>downward_camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>

      <!-- Depth / Pressure Sensor (IMU/Altimeter plugin simulation) -->
      <sensor name="depth_sensor" type="altimeter">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <plugin name="depth_sensor_plugin" filename="libgazebo_ros_altimeter.so">
          <ros>
            <namespace></namespace>
            <remapping>altimeter/imu:=/fmu/out/vehicle_odometry</remapping>
          </ros>
        </plugin>
      </sensor>

    </link>
  </model>
</sdf>
